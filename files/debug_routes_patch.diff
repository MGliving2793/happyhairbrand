+      total: amount,
+      phone: req.query.phone || '9999999999',
+      customer_name: req.query.name || 'Test User',
+      email: req.query.email || 'test@example.com'
+    };
+
+    const CF_ENV = process.env.CASHFREE_ENV || 'sandbox';
