+const express = require('express');
+const router = express.Router();
+
+// Lightweight debug logging endpoint for client-side events (temporary)
+// Logs small preview of event to server logs. Safe: does not store secrets.
+router.post('/log', express.json({ limit: '10kb' }), (req, res) => {
+  try {
+    const info = {
+      at: new Date().toISOString(),
+      ip: req.ip,
+      ua: req.get('User-Agent'),
+      bodyPreview: typeof req.body === 'object' ? JSON.stringify(req.body).slice(0, 1000) : String(req.body).slice(0, 1000)
+    };
+    console.log('[CLIENT-DEBUG]', info);
+  } catch (e) {
+    console.warn('[CLIENT-DEBUG] logging error', e && e.message);
+  }
+  res.status(204).end();
+});
+
+// Test checkout route - creates a temporary Cashfree session (does NOT persist an order)
+// Use: GET /api/debug/test-checkout?amount=10&email=test@example.com
+const cashfreeIntegration = require('../integrations/cashfree');
+router.get('/test-checkout', async (req, res) => {
+  try {
+    const amount = parseFloat(req.query.amount) || 1.0;
